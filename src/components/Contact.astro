---
const contactLinks = [
  { label: "Email", value: "jagansivam71@gmail.com", href: "mailto:jagansivam71@gmail.com" },
  { label: "GitHub", value: "github.com/jaganzutual", href: "https://github.com/jaganzutual" },
  { label: "LinkedIn", value: "linkedin.com/in/jagan28", href: "https://linkedin.com/in/jagan28" },
  { label: "X (Twitter)", value: "x.com/Jagansivam", href: "https://x.com/Jagansivam" },
];
---

<section id="contact" class="relative overflow-hidden py-24">
  <div
    class="pointer-events-none absolute -bottom-48 left-1/2 h-[400px] w-[700px] -translate-x-1/2 rounded-full bg-sky-500/10 blur-3xl"
  >
  </div>
  <div class="relative mx-auto max-w-3xl px-6 text-center">
    <p class="text-sm font-medium tracking-widest text-sky-400 uppercase">
      / Contact
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-white md:text-4xl">
      Let's build something.
    </h2>
    <p class="mt-4 text-slate-400">
      Open to AI/LLM engineering roles — full-time or contract.
      My inbox is always open.
    </p>
    <a
      href="mailto:jagansivam71@gmail.com"
      class="mt-8 inline-block rounded-lg bg-sky-500 px-8 py-3 font-semibold text-slate-950 transition hover:bg-sky-400"
    >
      Say Hello
    </a>
    <div class="mt-12 flex flex-wrap justify-center gap-x-10 gap-y-4">
      {
        contactLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel="noopener noreferrer"
            class="text-sm text-slate-400 transition hover:text-sky-400"
          >
            <span class="block text-xs uppercase tracking-wider text-slate-500">
              {link.label}
            </span>
            {link.value}
          </a>
        ))
      }
    </div>
  </div>
</section>
