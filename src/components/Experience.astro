---

<section id="experience" class="py-24">
  <div class="mx-auto max-w-5xl px-6">
    <p class="text-sm font-medium tracking-widest text-sky-400 uppercase">
      / Experience
    </p>
    <h2 class="reveal mt-3 text-3xl font-bold tracking-tight text-white md:text-4xl">
      My impact over the years.
    </h2>
    <ol class="mt-12 space-y-12 border-l border-white/10 pl-8">
      {
        jobs.map((job) => (
          <li class="relative">
            <span class="absolute -left-[37px] top-2 h-3 w-3 rounded-full border-2 border-sky-400 bg-slate-950" />
            <p class="text-sm text-sky-400">{job.period}</p>
            <h3 class="mt-1 text-xl font-semibold text-white">
              {job.role} ·{" "}
              <span class="text-slate-400">{job.company}</span>
            </h3>
            <p class="mt-0.5 text-sm text-slate-500">{job.location}</p>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-slate-400">
              {job.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
