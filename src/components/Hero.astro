---
import HeroScene from "./HeroScene.astro";
---

<section
  class="relative flex min-h-screen items-center justify-center overflow-hidden"
>
  <HeroScene />
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-sky-500/20 blur-3xl"
  >
  </div>
  <div class="relative mx-auto w-full max-w-6xl px-6 py-24">
    <p class="mb-6 text-xs font-medium tracking-[0.3em] text-sky-400 uppercase md:text-sm">
      AI/ML Engineer · Backend · Full-Stack · Agentic Systems
    </p>
    <h1
      class="select-none text-5xl leading-[0.9] font-black tracking-tighter uppercase sm:text-7xl md:text-8xl lg:text-[8rem]"
    >
      <span class="text-white">Jagan</span>
      <span class="text-outline block text-transparent sm:inline">Sivam</span>
    </h1>
    <div class="mt-10 flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="max-w-md space-y-4">
        <p class="leading-relaxed text-slate-400">
          I build AI agents, backend systems, and full-stack products.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#experience"
            class="rounded-lg bg-sky-500 px-6 py-3 font-semibold text-slate-950 transition hover:bg-sky-400"
          >
            View My Work
          </a>
          <a
            href="mailto:jagansivam71@gmail.com"
            class="rounded-lg border border-white/15 px-6 py-3 font-semibold text-slate-200 transition hover:border-sky-400/50 hover:text-sky-400"
          >
            Get In Touch
          </a>
        </div>
      </div>
      <div class="flex flex-col items-start gap-4 text-sm md:items-end">
        <div class="flex items-center gap-2 text-slate-400">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
          </span>
          India · Open to relocation
        </div>
        <p id="local-time" class="font-mono tabular-nums text-slate-500"></p>
        <div class="flex items-center gap-5">
          <a
            href="https://github.com/jaganzutual"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-slate-400 transition hover:text-sky-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.13v3.16c0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
          </a>
          <a
            href="https://linkedin.com/in/jagan28"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-slate-400 transition hover:text-sky-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z"/></svg>
          </a>
          <a
            href="https://x.com/Jagansivam"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (Twitter)"
            class="text-slate-400 transition hover:text-sky-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.49h2.04L6.49 3.24H4.3l13.31 17.4Z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function tick() {
    const el = document.getElementById("local-time");
    if (el) {
      el.textContent = new Intl.DateTimeFormat("en-GB", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        timeZone: "Asia/Kolkata",
      }).format(new Date()) + " IST";
    }
  }
  tick();
  setInterval(tick, 1000);
</script>
